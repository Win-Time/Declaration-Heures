# Token d'intégration interne Notion (secret — jamais exposé au client)
NOTION_TOKEN=

# IDs des bases Notion
NOTION_DB_ASSISTANTES=
NOTION_DB_CLIENTS=
NOTION_DB_DECLARATIONS=

# Optionnel : clé de signature du cookie de session (httpOnly).
# Si absent, la clé est dérivée de NOTION_TOKEN.
SESSION_SECRET=

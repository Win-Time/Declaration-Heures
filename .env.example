# Token d'intégration interne Notion (secret — jamais exposé au client)
NOTION_TOKEN=

# IDs des bases Notion
NOTION_DB_ASSISTANTES=
NOTION_DB_CLIENTS=
NOTION_DB_DECLARATIONS=

# Optionnel : clé de signature du cookie de session (httpOnly).
# Si absent, la clé est dérivée de NOTION_TOKEN.
SESSION_SECRET=

# Optionnel : domaine du site, utilisé pour les URLs absolues des métadonnées
# de partage. Sur Vercel, VERCEL_PROJECT_PRODUCTION_URL suffit.
SITE_URL=

# Optionnel mais recommandé : IDs des propriétés Notion. Un ID ne change pas
# quand la propriété est renommée, contrairement à son nom. Sans ces valeurs,
# les propriétés sont retrouvées par leur nom (repli tolérant à la casse, aux
# accents et aux espaces).
#
#   npm run notion:props
#
# les liste et affiche les lignes à coller ici.
NOTION_PROP_TELEPHONE=
NOTION_PROP_CONTRATS_CLIENTS=
NOTION_PROP_CONTRAT_CLIENT=
NOTION_PROP_PERIODE=
NOTION_PROP_ASSISTANTE=
NOTION_PROP_CONTRAT=
NOTION_PROP_HEURES=
NOTION_PROP_MINUTES=
